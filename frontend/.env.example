VITE_API_BASE_URL=http://127.0.0.1:8000

# Shared secret sent by the dashboard as the "X-API-Key" request header on
# every call to the API. Must match the API_KEY env var configured on the
# backend (Render). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VITE_API_KEY=

